<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dokumentasi API - Info Konser</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .doc-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 20px;
        }

        @media (max-width: 768px) {
            .doc-container {
                padding: 10px;
            }
            
            .doc-header h1 {
                font-size: 1.8em;
            }
            
            .param-row {
                grid-template-columns: 1fr;
                gap: 8px;
            }
            
            .quick-links {
                grid-template-columns: 1fr;
            }
        }

        .doc-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .doc-header h1 {
            margin: 0;
            font-size: 2.5em;
            font-weight: 700;
        }

        .doc-header p {
            margin: 10px 0 0 0;
            opacity: 0.9;
            font-size: 1.1em;
        }

        .doc-section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .doc-section:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

        .section-title {
            color: #667eea;
            font-size: 1.8em;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 3px solid #667eea;
            padding-bottom: 10px;
        }

        .section-icon {
            font-size: 1.2em;
        }

        .endpoint-card {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
            border-left: 5px solid #667eea;
            transition: all 0.3s;
            overflow: hidden;
            word-wrap: break-word;
        }

        .endpoint-card:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .method-badge {
            display: inline-block;
            padding: 6px 15px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9em;
            margin-right: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .method-get {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            box-shadow: 0 3px 10px rgba(56, 239, 125, 0.3);
        }

        .method-post {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            box-shadow: 0 3px 10px rgba(79, 172, 254, 0.3);
        }

        .code-block {
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 40px 20px 20px 20px;
            border-radius: 10px;
            overflow-x: auto;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 0.9em;
            margin: 15px 0;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
            position: relative;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        .code-block::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 30px;
            background: #2d2d2d;
            border-radius: 10px 10px 0 0;
            z-index: 0;
        }

        .quick-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .quick-link-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-decoration: none;
            text-align: center;
            transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .quick-link-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        .quick-link-card .icon {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .quick-link-card .title {
            font-weight: 600;
            font-size: 1.1em;
        }

        .info-box {
            background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%);
            border-left: 5px solid #00acc1;
            padding: 20px;
            margin: 20px 0;
            border-radius: 10px;
            overflow: hidden;
            word-wrap: break-word;
        }

        .warning-box {
            background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
            border-left: 5px solid #ff9800;
            padding: 20px;
            margin: 20px 0;
            border-radius: 10px;
            overflow: hidden;
            word-wrap: break-word;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }

        .feature-item {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            transition: all 0.3s;
        }

        .feature-item:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            transform: scale(1.05);
        }

        .feature-item .icon {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .nav-links {
            background: rgba(255,255,255,0.95);
            padding: 15px 25px;
            border-radius: 50px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        .nav-links a {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
            padding: 8px 15px;
            border-radius: 20px;
        }

        .nav-links a:hover {
            background: #667eea;
            color: white;
        }

        .param-row {
            background: #f8f9fa;
            padding: 12px;
            margin: 8px 0;
            border-radius: 8px;
            display: grid;
            grid-template-columns: 150px 100px 1fr;
            gap: 15px;
            align-items: center;
            overflow: hidden;
            word-wrap: break-word;
        }

        .param-name {
            font-weight: 600;
            color: #667eea;
            font-family: monospace;
        }

        .badge-required {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.8em;
            font-weight: 600;
        }

        .badge-optional {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.8em;
            font-weight: 600;
        }

        .response-example {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            margin: 15px 0;
            border-left: 4px solid #667eea;
        }

        .tabs {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin: 20px 0;
        }

        .tab {
            padding: 10px 20px;
            background: #e9ecef;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }

        .tab:hover, .tab.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="navbar">
            <h1>📚 Dokumentasi API</h1>
            <div class="user-info">
                <span>Halo, <%= name %></span>
                <a href="/logout">Logout</a>
            </div>
        </div>

        <div class="nav-links">
            <a href="/user/dashboard">🏠 Dashboard</a>
            <a href="/user/api-explorer">🔍 API Explorer</a>
            <a href="/user/concerts">🎵 Daftar Konser</a>
        </div>

        <div class="doc-container">
            <!-- Header -->
            <div class="doc-header">
                <h1>🎵 API Info Konser</h1>
                <p>Dokumentasi lengkap untuk mengintegrasikan sistem Anda dengan API Info Konser</p>
            </div>

            <!-- Quick Links -->
            <div class="quick-links">
                <a href="#intro" class="quick-link-card">
                    <div class="icon">📖</div>
                    <div class="title">Pendahuluan</div>
                </a>
                <a href="#auth" class="quick-link-card">
                    <div class="icon">🔐</div>
                    <div class="title">Autentikasi</div>
                </a>
                <a href="#endpoints" class="quick-link-card">
                    <div class="icon">🔌</div>
                    <div class="title">Endpoints</div>
                </a>
                <a href="#examples" class="quick-link-card">
                    <div class="icon">💻</div>
                    <div class="title">Contoh Kode</div>
                </a>
            </div>

            <!-- Pendahuluan -->
            <div class="doc-section" id="intro">
                <div class="section-title">
                    <span class="section-icon">📖</span>
                    <span>Pendahuluan</span>
                </div>
                
                <p>API Info Konser menyediakan akses terprogram untuk mendapatkan informasi tentang konser musik.</p>
                
                <div class="info-box">
                    <strong>ℹ️ Informasi API</strong><br>
                    <strong>Base URL:</strong> <code>http://localhost:3001</code><br>
                    <strong>Format:</strong> JSON<br>
                    <strong>Auth:</strong> API Key (X-API-Key header)
                </div>

                <div class="feature-grid">
                    <div class="feature-item">
                        <div class="icon">📋</div>
                        <strong>List Konser</strong>
                    </div>
                    <div class="feature-item">
                        <div class="icon">🔍</div>
                        <strong>Detail Konser</strong>
                    </div>
                    <div class="feature-item">
                        <div class="icon">🎸</div>
                        <strong>Filter Genre</strong>
                    </div>
                    <div class="feature-item">
                        <div class="icon">🔎</div>
                        <strong>Pencarian</strong>
                    </div>
                </div>
            </div>

            <!-- Autentikasi -->
            <div class="doc-section" id="auth">
                <div class="section-title">
                    <span class="section-icon">🔐</span>
                    <span>Autentikasi</span>
                </div>
                
                <p>Semua request memerlukan API Key yang valid di header request:</p>

                <div class="code-block">X-API-Key: your-api-key-here</div>

                <div class="warning-box">
                    <strong>⚠️ Penting:</strong>
                    <ul style="margin: 10px 0 0 0; padding-left: 20px;">
                        <li>Jangan bagikan API Key Anda</li>
                        <li>Generate API Key baru di Dashboard</li>
                        <li>API Key baru menonaktifkan yang lama</li>
                    </ul>
                </div>
            </div>

            <!-- API Endpoints -->
            <div class="doc-section" id="endpoints">
                <div class="section-title">
                    <span class="section-icon">🔌</span>
                    <span>API Endpoints</span>
                </div>

                <!-- Get All Concerts -->
                <div class="endpoint-card">
                    <h3>
                        <span class="method-badge method-get">GET</span>
                        /api/concerts
                    </h3>
                    <p>Mendapatkan daftar semua konser</p>

                    <h4>Parameters:</h4>
                    <div class="param-row">
                        <span class="param-name">genre</span>
                        <span class="badge-optional">Optional</span>
                        <span>Filter: rock, pop, jazz, electronic</span>
                    </div>
                    <div class="param-row">
                        <span class="param-name">search</span>
                        <span class="badge-optional">Optional</span>
                        <span>Cari berdasarkan nama artis/judul</span>
                    </div>

                    <h4>Contoh Request:</h4>
                    <div class="code-block">fetch('http://localhost:3001/api/concerts', {
  headers: { 'X-API-Key': 'your-api-key' }
})
.then(res => res.json())
.then(data => console.log(data));</div>

                    <h4>Response:</h4>
                    <div class="code-block">{
  "success": true,
  "data": [{
    "id": 1,
    "name": "Rock Festival 2026",
    "artist": "The Rockers",
    "genre": "rock",
    "date": "2026-03-15",
    "location": "Jakarta Stadium",
    "price": 500000,
    ...
  }]
}</div>
                </div>

                <!-- Get Concert by ID -->
                <div class="endpoint-card">
                    <h3>
                        <span class="method-badge method-get">GET</span>
                        /api/concerts/:id
                    </h3>
                    <p>Mendapatkan detail konser spesifik</p>

                    <h4>Parameters:</h4>
                    <div class="param-row">
                        <span class="param-name">id</span>
                        <span class="badge-required">Required</span>
                        <span>ID konser (URL parameter)</span>
                    </div>

                    <h4>Contoh Request:</h4>
                    <div class="code-block">fetch('http://localhost:3001/api/concerts/1', {
  headers: { 'X-API-Key': 'your-api-key' }
})
.then(res => res.json())
.then(data => console.log(data));</div>
                </div>

                <!-- Filter & Search -->
                <div class="endpoint-card">
                    <h3>🎸 Filter & Search</h3>
                    
                    <h4>Filter by Genre:</h4>
                    <div class="code-block">GET /api/concerts?genre=rock</div>

                    <h4>Search:</h4>
                    <div class="code-block">GET /api/concerts?search=Rock Festival</div>

                    <h4>Combine:</h4>
                    <div class="code-block">GET /api/concerts?genre=pop&search=Jakarta</div>
                </div>
            </div>

            <!-- Error Handling -->
            <div class="doc-section">
                <div class="section-title">
                    <span class="section-icon">⚠️</span>
                    <span>Error Handling</span>
                </div>

                <div class="response-example">
                    <strong>Format Error Response:</strong>
                    <div class="code-block" style="margin-top: 10px;">{ "success": false, "error": "Deskripsi error" }</div>
                </div>

                <h4>HTTP Status Codes:</h4>
                <div class="param-row">
                    <span class="param-name">200</span>
                    <span style="color: #38ef7d; font-weight: 600;">Success</span>
                    <span>Request berhasil</span>
                </div>
                <div class="param-row">
                    <span class="param-name">401</span>
                    <span style="color: #ff6b6b; font-weight: 600;">Unauthorized</span>
                    <span>API Key tidak valid</span>
                </div>
                <div class="param-row">
                    <span class="param-name">404</span>
                    <span style="color: #ff9800; font-weight: 600;">Not Found</span>
                    <span>Resource tidak ditemukan</span>
                </div>
                <div class="param-row">
                    <span class="param-name">500</span>
                    <span style="color: #f56565; font-weight: 600;">Server Error</span>
                    <span>Kesalahan server</span>
                </div>
            </div>

            <!-- Contoh Penggunaan -->
            <div class="doc-section" id="examples">
                <div class="section-title">
                    <span class="section-icon">💻</span>
                    <span>Contoh Penggunaan</span>
                </div>

                <div class="tabs">
                    <button class="tab active" onclick="showCode('js')">JavaScript</button>
                    <button class="tab" onclick="showCode('react')">React</button>
                    <button class="tab" onclick="showCode('python')">Python</button>
                    <button class="tab" onclick="showCode('node')">Node.js</button>
                </div>

                <div id="code-js" class="code-content">
                    <h4>JavaScript (Vanilla):</h4>
                    <div class="code-block">const API_KEY = 'your-api-key';
const BASE_URL = 'http://localhost:3001';

async function getConcerts() {
  const response = await fetch(`${BASE_URL}/api/concerts`, {
    headers: { 'X-API-Key': API_KEY }
  });
  const result = await response.json();
  
  if (result.success) {
    console.log(result.data);
  }
}</div>
                </div>

                <div id="code-react" class="code-content" style="display:none;">
                    <h4>React:</h4>
                    <div class="code-block">import { useState, useEffect } from 'react';

function ConcertList() {
  const [concerts, setConcerts] = useState([]);
  const API_KEY = 'your-api-key';

  useEffect(() => {
    fetch('http://localhost:3001/api/concerts', {
      headers: { 'X-API-Key': API_KEY }
    })
    .then(res => res.json())
    .then(data => setConcerts(data.data));
  }, []);

  return (
    <div>
      {concerts.map(c => <div key={c.id}>{c.name}</div>)}
    </div>
  );
}</div>
                </div>

                <div id="code-python" class="code-content" style="display:none;">
                    <h4>Python:</h4>
                    <div class="code-block">import requests

API_KEY = 'your-api-key'
headers = {'X-API-Key': API_KEY}

response = requests.get(
  'http://localhost:3001/api/concerts',
  headers=headers
)

result = response.json()
if result['success']:
  for concert in result['data']:
    print(concert['name'])</div>
                </div>

                <div id="code-node" class="code-content" style="display:none;">
                    <h4>Node.js (Axios):</h4>
                    <div class="code-block">const axios = require('axios');

const API_KEY = 'your-api-key';

axios.get('http://localhost:3001/api/concerts', {
  headers: { 'X-API-Key': API_KEY }
})
.then(response => {
  if (response.data.success) {
    console.log(response.data.data);
  }
})
.catch(error => console.error(error));</div>
                </div>

                <div class="info-box" style="margin-top: 30px;">
                    <strong>✅ Best Practices:</strong>
                    <ul style="margin: 10px 0 0 0; padding-left: 20px;">
                        <li>Simpan API Key di environment variables</li>
                        <li>Implementasikan error handling</li>
                        <li>Cache data untuk efisiensi</li>
                        <li>Gunakan API Explorer untuk testing</li>
                    </ul>
                </div>
            </div>

            <!-- Footer -->
            <div class="doc-section" style="text-align: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h3 style="color: white;">🎵 Mulai Build Aplikasi Anda!</h3>
                <p>Gunakan API Explorer untuk testing dan eksperimen dengan API kami</p>
                <a href="/user/api-explorer" style="display: inline-block; background: white; color: #667eea; padding: 12px 30px; border-radius: 25px; text-decoration: none; font-weight: 600; margin-top: 15px;">
                    Coba Sekarang →
                </a>
            </div>
        </div>
    </div>

    <script>
        function showCode(lang) {
            // Hide all code contents
            document.querySelectorAll('.code-content').forEach(el => {
                el.style.display = 'none';
            });
            
            // Remove active class from all tabs
            document.querySelectorAll('.tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Show selected code content
            document.getElementById(`code-${lang}`).style.display = 'block';
            
            // Add active class to clicked tab
            event.target.classList.add('active');
        }
    </script>
</body>
</html>
